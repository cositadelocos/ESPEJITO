<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Espejo Empañado — Dibuja con los dedos</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    width: 100%; height: 100%;
    background: #0a0a0a;
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    overflow: hidden;
  }
  #container {
    position: relative;
    width: 100vw; height: 100vh;
    overflow: hidden;
    background: #000;
  }
  video, canvas#fog {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scaleX(-1); /* espejado natural */
    width: 100%; height: 100%;
    object-fit: cover;
  }
  video { filter: saturate(0.9) brightness(0.95); }
  canvas#fog { z-index: 2; }

  #ui {
    position: absolute;
    top: 0; left: 0; width: 100%;
    z-index: 10;
    display: flex; flex-direction: column; align-items: center;
    padding: 24px 16px;
    pointer-events: none;
  }
  #ui .panel {
    pointer-events: all;
    display: flex; gap: 10px; align-items: center;
    background: rgba(20,20,20,0.55);
    backdrop-filter: blur(6px);
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.12);
  }
  button {
    font-size: 14px;
    padding: 9px 16px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    background: rgba(255,255,255,0.92);
    color: #111;
    font-weight: 600;
    transition: transform .15s ease, background .15s ease;
  }
  button:hover { transform: translateY(-1px); }
  button#resetBtn { background: rgba(255,255,255,0.15); color: #fff; }

  #status {
    margin-top: 12px;
    color: rgba(255,255,255,0.85);
    font-size: 13px;
    text-align: center;
    text-shadow: 0 1px 3px rgba(0,0,0,0.6);
    pointer-events: none;
  }
  #loading {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    color: #eee; font-size: 14px; z-index: 20;
    background: #0a0a0a;
  }
  .hidden { display: none !important; }
  #pinchDot {
    position: absolute;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    box-shadow: 0 0 12px 4px rgba(255,255,255,0.5);
    pointer-events: none;
    z-index: 5;
    display: none;
    transform: translate(-50%, -50%);
  }
</style>
</head>
<body>
<div id="container">
  <video id="video" autoplay playsinline muted></video>
  <canvas id="fog"></canvas>
  <div id="pinchDot"></div>

  <div id="ui">
    <div class="panel">
      <button id="startBtn">Iniciar cámara</button>
      <button id="resetBtn">Volver a empañar</button>
    </div>
    <div id="status">Pellizca (junta pulgar e índice) y mueve la mano para escribir ✍️</div>
  </div>

  <div id="loading" class="hidden">Cargando modelo de manos…</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/hands.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils@0.3.1675466862/camera_utils.js" crossorigin="anonymous"></script>

<script>
const video = document.getElementById('video');
const fogCanvas = document.getElementById('fog');
const fogCtx = fogCanvas.getContext('2d', { willReadFrequently: true });
const startBtn = document.getElementById('startBtn');
const resetBtn = document.getElementById('resetBtn');
const statusEl = document.getElementById('status');
const loadingEl = document.getElementById('loading');
const pinchDot = document.getElementById('pinchDot');

let camera = null;
let lastPoint = null;
let smoothed = null;
let ready = false;

// ---------- Generación del vaho (versión estética "vidrio esmerilado") ----------
function paintFog() {
  const w = fogCanvas.width, h = fogCanvas.height;
  fogCtx.clearRect(0, 0, w, h);
  fogCtx.globalCompositeOperation = 'source-over';

  // 1) Base: degradado radial frío, tipo neblina suave (luz desde arriba-izquierda)
  const base = fogCtx.createRadialGradient(
    w * 0.32, h * 0.28, 0,
    w * 0.5, h * 0.55, Math.max(w, h) * 0.9
  );
  base.addColorStop(0, 'rgba(238,244,246,0.90)');
  base.addColorStop(0.45, 'rgba(214,224,227,0.90)');
  base.addColorStop(1, 'rgba(178,190,195,0.92)');
  fogCtx.fillStyle = base;
  fogCtx.fillRect(0, 0, w, h);

  // 2) Nubes grandes y suaves (nada de puntitos duros)
  fogCtx.filter = 'blur(55px)';
  const cloudPalette = [
    'rgba(255,255,255,0.10)',
    'rgba(255,255,255,0.06)',
    'rgba(205,220,225,0.10)',
    'rgba(190,205,212,0.08)'
  ];
  const clouds = 26;
  for (let i = 0; i < clouds; i++) {
    const x = Math.random() * w;
    const y = Math.random() * h;
    const r = w * (0.10 + Math.random() * 0.18);
    fogCtx.beginPath();
    fogCtx.fillStyle = cloudPalette[i % cloudPalette.length];
    fogCtx.ellipse(x, y, r, r * (0.6 + Math.random() * 0.5), Math.random() * Math.PI, 0, Math.PI * 2);
    fogCtx.fill();
  }
  fogCtx.filter = 'none';

  // 3) Brillo diagonal, como un reflejo de luz sobre el vidrio
  fogCtx.filter = 'blur(30px)';
  const streak = fogCtx.createLinearGradient(0, h * 0.1, w * 0.6, h);
  streak.addColorStop(0, 'rgba(255,255,255,0.16)');
  streak.addColorStop(0.35, 'rgba(255,255,255,0.04)');
  streak.addColorStop(1, 'rgba(255,255,255,0)');
  fogCtx.fillStyle = streak;
  fogCtx.beginPath();
  fogCtx.moveTo(0, 0);
  fogCtx.lineTo(w * 0.55, 0);
  fogCtx.lineTo(w * 0.15, h);
  fogCtx.lineTo(-w * 0.2, h);
  fogCtx.closePath();
  fogCtx.fill();
  fogCtx.filter = 'none';

  // 4) Grano fino, muy sutil, para dar textura real de condensación
  fogCtx.filter = 'blur(0.6px)';
  const grains = 420;
  for (let i = 0; i < grains; i++) {
    const x = Math.random() * w;
    const y = Math.random() * h;
    const r = 0.6 + Math.random() * 1.4;
    const a = 0.015 + Math.random() * 0.02;
    fogCtx.beginPath();
    fogCtx.fillStyle = `rgba(255,255,255,${a})`;
    fogCtx.arc(x, y, r, 0, Math.PI * 2);
    fogCtx.fill();
  }
  fogCtx.filter = 'none';

  // 5) Viñeta suave en los bordes, para profundidad
  const vign = fogCtx.createRadialGradient(
    w / 2, h / 2, Math.min(w, h) * 0.35,
    w / 2, h / 2, Math.max(w, h) * 0.72
  );
  vign.addColorStop(0, 'rgba(0,0,0,0)');
  vign.addColorStop(1, 'rgba(40,50,55,0.16)');
  fogCtx.fillStyle = vign;
  fogCtx.fillRect(0, 0, w, h);
}

function resizeCanvas() {
  const w = video.videoWidth || 1280;
  const h = video.videoHeight || 720;
  fogCanvas.width = w;
  fogCanvas.height = h;
  paintFog();
}

// ---------- Borrado con el gesto de pellizco ----------
function wipeAt(x, y, radius) {
  fogCtx.save();
  fogCtx.globalCompositeOperation = 'destination-out';
  // núcleo bien limpio, borde con caída suave tipo "empañado que se disuelve"
  const grad = fogCtx.createRadialGradient(x, y, 0, x, y, radius);
  grad.addColorStop(0, 'rgba(0,0,0,1)');
  grad.addColorStop(0.55, 'rgba(0,0,0,0.95)');
  grad.addColorStop(0.8, 'rgba(0,0,0,0.55)');
  grad.addColorStop(1, 'rgba(0,0,0,0)');
  fogCtx.fillStyle = grad;
  fogCtx.beginPath();
  fogCtx.arc(x, y, radius, 0, Math.PI * 2);
  fogCtx.fill();
  fogCtx.restore();

  // un halo tenue justo en el borde, como la humedad que queda al limpiar
  fogCtx.save();
  fogCtx.globalCompositeOperation = 'source-over';
  fogCtx.strokeStyle = 'rgba(255,255,255,0.10)';
  fogCtx.lineWidth = Math.max(1, radius * 0.08);
  fogCtx.filter = 'blur(2px)';
  fogCtx.beginPath();
  fogCtx.arc(x, y, radius * 0.92, 0, Math.PI * 2);
  fogCtx.stroke();
  fogCtx.filter = 'none';
  fogCtx.restore();
}

function wipeLine(x1, y1, x2, y2, radius) {
  const dist = Math.hypot(x2 - x1, y2 - y1);
  const steps = Math.max(1, Math.floor(dist / (radius * 0.35)));
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    wipeAt(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t, radius);
  }
}

// ---------- MediaPipe Hands ----------
const hands = new Hands({
  locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/${file}`
});
hands.setOptions({
  maxNumHands: 1,
  modelComplexity: 1,
  minDetectionConfidence: 0.6,
  minTrackingConfidence: 0.6
});

hands.onResults((results) => {
  if (!ready) return;

  const w = fogCanvas.width, h = fogCanvas.height;

  if (!results.multiHandLandmarks || results.multiHandLandmarks.length === 0) {
    pinchDot.style.display = 'none';
    lastPoint = null;
    return;
  }

  const lm = results.multiHandLandmarks[0];
  const thumbTip = lm[4];
  const indexTip = lm[8];
  const wrist = lm[0];
  const middleMcp = lm[9];

  // escala de la mano para umbral de pellizco adaptable a la distancia a la cámara
  const handScale = Math.hypot(
    (middleMcp.x - wrist.x) * w,
    (middleMcp.y - wrist.y) * h
  );

  const px = (thumbTip.x + indexTip.x) / 2 * w;
  const py = (thumbTip.y + indexTip.y) / 2 * h;

  const pinchDist = Math.hypot(
    (thumbTip.x - indexTip.x) * w,
    (thumbTip.y - indexTip.y) * h
  );

  const pinchThreshold = handScale * 0.45;
  const isPinching = pinchDist < pinchThreshold;

  // posicionar el punto visual (recordando que video/canvas están espejados por CSS,
  // así que usamos las coords "crudas" tal cual, igual que se dibuja en el canvas)
  const rect = fogCanvas.getBoundingClientRect();
  const scaleX = rect.width / w;
  const scaleY = rect.height / h;
  // como el contenedor está espejado (scaleX(-1)), el punto visible en pantalla
  // queda invertido en X respecto al rect
  const screenX = rect.right - (px * scaleX);
  const screenY = rect.top + (py * scaleY);

  if (isPinching) {
    pinchDot.style.display = 'block';
    pinchDot.style.left = screenX + 'px';
    pinchDot.style.top = screenY + 'px';

    const brushRadius = Math.max(14, handScale * 0.22);

    if (lastPoint) {
      wipeLine(lastPoint.x, lastPoint.y, px, py, brushRadius);
    } else {
      wipeAt(px, py, brushRadius);
    }
    lastPoint = { x: px, y: py };
  } else {
    pinchDot.style.display = 'none';
    lastPoint = null;
  }
});

// ---------- Arranque de cámara ----------
startBtn.addEventListener('click', async () => {
  startBtn.disabled = true;
  loadingEl.classList.remove('hidden');
  statusEl.textContent = 'Solicitando acceso a la cámara…';

  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: { width: 1280, height: 720, facingMode: 'user' },
      audio: false
    });
    video.srcObject = stream;

    video.onloadedmetadata = () => {
      resizeCanvas();
      ready = true;
      loadingEl.classList.add('hidden');
      statusEl.textContent = 'Pellizca (junta pulgar e índice) y mueve la mano para escribir ✍️';
    };

    camera = new Camera(video, {
      onFrame: async () => {
        await hands.send({ image: video });
      },
      width: 1280,
      height: 720
    });
    camera.start();

    startBtn.textContent = 'Cámara activa';
  } catch (err) {
    loadingEl.classList.add('hidden');
    startBtn.disabled = false;
    statusEl.textContent = 'No se pudo acceder a la cámara: ' + err.message;
  }
});

resetBtn.addEventListener('click', () => {
  if (ready) paintFog();
});

window.addEventListener('resize', () => {
  // el canvas mantiene su resolución interna ligada al video; solo el CSS reescala
});
</script>
</body>
</html>
